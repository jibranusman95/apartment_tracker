#!/usr/bin/env ruby
# Tests the DistanceService (Nominatim geocoding + OpenRouteService routing).
# Run with: bin/rails runner bin/test_distance

FakeListing = Struct.new(:street_address, :neighbourhood, :city, keyword_init: true)

TEST_CASES = [
  { label: "Street address (precise)",   street_address: "4090 Living Arts Dr", city: "Mississauga" },
  { label: "Neighbourhood only",         street_address: nil,                    city: "Oakville",     neighbourhood: "Kerr Village" },
  { label: "City only (fallback)",       street_address: nil,                    city: "Burlington",   neighbourhood: nil },
  { label: "Workplace itself (0km ~0min)", street_address: "603 Michigan Drive", city: "Oakville" }
].freeze

puts "=" * 55
puts "DistanceService Status Check"
puts "=" * 55

ors_key = ENV["OPENROUTESERVICE_API_KEY"]
puts "\nORS key: #{ors_key&.first(10)&.+(  "...") || "❌ NOT SET — set OPENROUTESERVICE_API_KEY"}"
puts

svc = DistanceService.new

# Test Nominatim geocoding
puts "── Nominatim geocode test ──"
coords = svc.send(:geocode, "4090 Living Arts Dr, Mississauga, ON, Canada")
puts coords ? "  ✅ #{coords.inspect}" : "  ❌ geocode returned nil"
puts

# Test ORS routing with hardcoded workplace coords
if coords
  puts "── ORS route test ──"
  summary = svc.send(:fetch_route, ENV["OPENROUTESERVICE_API_KEY"], coords, DistanceService::WORKPLACE_COORDS)
  puts summary ? "  ✅ #{summary.inspect}" : "  ❌ fetch_route returned nil"
  puts
end

puts "── Full compute_for tests ──\n\n"

TEST_CASES.each do |tc|
  listing = FakeListing.new(
    street_address: tc[:street_address],
    neighbourhood:  tc[:neighbourhood],
    city:           tc[:city]
  )

  address = if listing.street_address.present?
    "#{listing.street_address}, #{listing.city}, ON"
  else
    [ listing.neighbourhood, listing.city, "ON" ].compact.join(", ")
  end

  print "  #{tc[:label]}\n  (#{address})\n  → "

  result = DistanceService.compute_for(listing)

  if result
    puts "✅ #{result.distance_km}km / #{result.drive_minutes}min\n\n"
  else
    puts "❌ FAILED\n\n"
  end

  sleep 1.2 # Nominatim rate limit
end

puts "=" * 55
