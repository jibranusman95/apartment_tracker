<% content_for :title, "Add Listing" %>

<%# ── AI Loading overlay ── %>
<div id="ai-loading" class="hidden fixed inset-0 z-50 bg-white/90 backdrop-blur-sm flex flex-col items-center justify-center gap-4">
  <div class="w-12 h-12 rounded-full border-4 border-indigo-200 border-t-indigo-600 animate-spin"></div>
  <p class="text-gray-700 font-medium text-sm">Extracting listing with AI…</p>
  <p class="text-gray-400 text-xs">This may take up to 15 seconds</p>
</div>

<header class="sticky top-0 z-40 bg-white border-b border-gray-200 shadow-sm">
  <div class="px-4 sm:px-6 py-3 flex items-center gap-3">
    <%= link_to root_path, class: "text-indigo-600 font-medium text-sm hover:text-indigo-800" do %>
      ← Back
    <% end %>
    <h1 class="text-lg font-bold text-gray-900">Add Listing</h1>
  </div>
</header>

<div class="px-4 sm:px-6 py-6 max-w-2xl mx-auto space-y-5">
  <% if flash.now[:warning] || @fallback_to_paste %>
    <div class="rounded-xl bg-amber-50 border border-amber-200 px-4 py-3 text-sm text-amber-800">
      <%= flash.now[:warning] || "Paste the listing description below." %>
    </div>
  <% end %>
  <% if flash.now[:error] %>
    <div class="rounded-xl bg-red-50 border border-red-200 px-4 py-3 text-sm text-red-700">
      <%= flash.now[:error] %>
    </div>
  <% end %>

  <%= form_with model: @listing, url: listings_path, method: :post, class: "space-y-5" do |f| %>

    <%# ── URL — always present, always submits ── %>
    <div class="bg-white rounded-2xl border border-gray-200 p-4 space-y-1">
      <%= f.label :url, "Listing URL", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.url_field :url,
            id: "listing_url_field",
            placeholder: "https://kijiji.ca/...",
            class: "w-full rounded-xl border border-gray-300 px-3 py-3 text-sm focus:outline-none
                    focus:ring-2 focus:ring-indigo-500 focus:border-transparent bg-white" %>
      <p id="url-hint" class="text-xs text-gray-400 mt-1">
        Paste a link and we'll fetch it automatically — or leave blank and paste the text below.
      </p>
      <p id="url-hint-paste" class="text-xs text-gray-400 mt-1 hidden">
        Optional — add the original link for reference (won't be fetched in paste mode).
      </p>
    </div>

    <%# ── Mode toggle — only controls whether we scrape the URL or use pasted text ── %>
    <div class="bg-white rounded-2xl border border-gray-200 p-4 space-y-4">
      <h2 class="font-semibold text-gray-900">Listing description</h2>

      <div class="flex rounded-xl overflow-hidden border border-gray-200">
        <button type="button" id="btn-link"
                onclick="switchMode('link')"
                class="flex-1 py-2.5 text-sm font-medium transition-colors
                       <%= @fallback_to_paste ? "bg-white text-gray-600" : "bg-indigo-600 text-white" %>">
          🔗 Fetch from URL
        </button>
        <button type="button" id="btn-paste"
                onclick="switchMode('paste')"
                class="flex-1 py-2.5 text-sm font-medium transition-colors
                       <%= @fallback_to_paste ? "bg-indigo-600 text-white" : "bg-white text-gray-600" %>">
          📋 Paste Text
        </button>
      </div>

      <%= f.hidden_field :input_mode, value: @fallback_to_paste ? "paste" : "link", id: "input_mode_field" %>

      <%# Link mode hint %>
      <div id="link-hint" class="<%= @fallback_to_paste ? "hidden" : "" %>">
        <p class="text-sm text-gray-500">We'll scrape the URL above and extract the details automatically.</p>
      </div>

      <%# Paste panel — only shown in paste mode %>
      <div id="paste-panel" class="<%= @fallback_to_paste ? "" : "hidden" %> space-y-2">
        <%= f.label :raw_text, "Paste the listing description", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.text_area :raw_text,
              rows: 10,
              placeholder: "Paste the full listing description here…",
              class: "w-full rounded-xl border border-gray-300 px-3 py-3 text-sm focus:outline-none
                      focus:ring-2 focus:ring-indigo-500 focus:border-transparent bg-white resize-none" %>
      </div>
    </div>

    <%# ── Source field ── %>
    <div class="bg-white rounded-2xl border border-gray-200 p-4 space-y-1">
      <div class="flex items-center justify-between mb-1">
        <%= f.label :source, "Source / Website", class: "text-sm font-medium text-gray-700", for: "listing_source_field" %>
        <span id="source-hint" class="text-xs text-emerald-600 hidden">✓ Auto-detected</span>
      </div>
      <%= f.text_field :source,
            id: "listing_source_field",
            placeholder: "e.g. Kijiji, Facebook Marketplace, Zumper…",
            class: "w-full rounded-xl border border-gray-300 px-3 py-3 text-sm focus:outline-none
                    focus:ring-2 focus:ring-indigo-500 focus:border-transparent bg-white" %>
      <p class="text-xs text-gray-400">Auto-filled from the URL when possible. Edit if needed.</p>
    </div>

    <%= f.submit "Extract & Score with AI ✨",
          class: "w-full bg-indigo-600 hover:bg-indigo-700 active:bg-indigo-800 text-white
                  font-semibold rounded-2xl py-4 text-base transition-colors shadow-sm cursor-pointer",
          data: { turbo_submits_with: "Analysing listing…" } %>
  <% end %>
</div>

<script>
  // Mode toggle — shows/hides paste textarea, never touches the URL field
  function switchMode(mode) {
    const pastePanel   = document.getElementById("paste-panel");
    const linkHint     = document.getElementById("link-hint");
    const modeField    = document.getElementById("input_mode_field");
    const btnLink      = document.getElementById("btn-link");
    const btnPaste     = document.getElementById("btn-paste");
    const urlHint      = document.getElementById("url-hint");
    const urlHintPaste = document.getElementById("url-hint-paste");

    if (mode === "link") {
      pastePanel.classList.add("hidden");
      linkHint.classList.remove("hidden");
      modeField.value = "link";
      urlHint.classList.remove("hidden");
      urlHintPaste.classList.add("hidden");
      btnLink.classList.replace("bg-white",     "bg-indigo-600");
      btnLink.classList.replace("text-gray-600", "text-white");
      btnPaste.classList.replace("bg-indigo-600", "bg-white");
      btnPaste.classList.replace("text-white",   "text-gray-600");
    } else {
      pastePanel.classList.remove("hidden");
      linkHint.classList.add("hidden");
      modeField.value = "paste";
      urlHint.classList.add("hidden");
      urlHintPaste.classList.remove("hidden");
      btnPaste.classList.replace("bg-white",     "bg-indigo-600");
      btnPaste.classList.replace("text-gray-600", "text-white");
      btnLink.classList.replace("bg-indigo-600", "bg-white");
      btnLink.classList.replace("text-white",    "text-gray-600");
    }
  }

  // Show loading overlay on form submit
  document.querySelector("form")?.addEventListener("submit", function() {
    document.getElementById("ai-loading").classList.remove("hidden");
  });

  // Hide loading overlay if Turbo navigates away (e.g. validation error)
  document.addEventListener("turbo:render", function() {
    document.getElementById("ai-loading")?.classList.add("hidden");
  });

  // Auto-resolve source from URL on blur
  document.getElementById("listing_url_field")?.addEventListener("blur", function() {
    const url = this.value.trim();
    if (!url) return;

    fetch(`<%= resolve_source_listings_path %>?url=${encodeURIComponent(url)}`, {
      headers: { "Accept": "application/json" }
    })
    .then(r => r.json())
    .then(data => {
      const sourceField = document.getElementById("listing_source_field");
      const hint = document.getElementById("source-hint");
      if (data.source && sourceField && !sourceField.value) {
        sourceField.value = data.source;
        hint.classList.remove("hidden");
      }
    })
    .catch(() => {});
  });
</script>
