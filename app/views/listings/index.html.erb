<% content_for :title, "Home Finder" %>

<%# ── Header ── %>
<header class="sticky top-0 z-40 bg-white border-b border-gray-200 shadow-sm">
  <div class="max-w-2xl mx-auto px-4 py-3 flex items-center justify-between">
    <h1 class="text-lg font-bold text-gray-900">🏠 Home Finder</h1>
    <div class="flex items-center gap-2">
      <span class="text-xs text-gray-400"><%= @listings.size %> listing<%= @listings.size == 1 ? "" : "s" %></span>
      <%= button_to session_path, method: :delete,
            class: "text-xs text-gray-400 hover:text-gray-600 px-2 py-1 rounded-lg hover:bg-gray-100 transition-colors" do %>
        Sign out
      <% end %>
    </div>
  </div>

  <%# Filter pills %>
  <div class="max-w-2xl mx-auto px-4 pb-3 flex gap-2 overflow-x-auto scrollbar-hide">
    <% filters = [
         ["All",          nil,          "all"],
         ["Under $2k",    "under_2k",   "under_2k"],
         ["2 Bedrooms",   "two_br",     "two_br"],
         ["Has Parking",  "has_parking","has_parking"],
       ] %>
    <% filters.each do |label, value, key| %>
      <% active = params[:filter].to_s == key.to_s || (params[:filter].blank? && value.nil?) %>
      <%= link_to root_path(filter: value),
            class: "shrink-0 rounded-full px-4 py-1.5 text-sm font-medium border transition-colors
                    #{active ? "bg-indigo-600 text-white border-indigo-600" : "bg-white text-gray-600 border-gray-300 hover:border-indigo-400"}" do %>
        <%= label %>
      <% end %>
    <% end %>
  </div>
</header>

<%# ── Listing Cards ── %>
<div class="px-4 pt-4 space-y-3">
  <% if @listings.empty? %>
    <div class="text-center py-20 text-gray-400">
      <div class="text-5xl mb-3">🔍</div>
      <p class="font-medium">No listings yet</p>
      <p class="text-sm mt-1">Tap + to add your first one</p>
    </div>
  <% end %>

  <% @listings.each do |listing| %>
    <%= link_to listing_path(listing), class: "block" do %>
      <div class="relative rounded-2xl bg-white border border-gray-200 shadow-sm p-4 transition-all
                  <%= listing.gone? ? "opacity-50" : "hover:shadow-md hover:border-indigo-200 active:scale-99" %>">

        <%# "Gone" overlay badge %>
        <% if listing.gone? %>
          <div class="absolute inset-0 rounded-2xl flex items-center justify-center bg-gray-100/60">
            <span class="bg-gray-700 text-white text-xs font-bold px-3 py-1 rounded-full rotate-[-8deg]">GONE</span>
          </div>
        <% end %>

        <%# Top row: location + score badge %>
        <div class="flex items-start justify-between gap-2 mb-2">
          <div>
            <p class="font-semibold text-gray-900 leading-tight">
              <%= listing.neighbourhood.presence || "Unknown area" %>
            </p>
            <p class="text-xs text-gray-500"><%= listing.city.presence || "—" %></p>
          </div>
          <% if listing.score %>
            <% color = listing.score_color %>
            <span class="shrink-0 rounded-full px-2.5 py-1 text-sm font-bold
              <%= color == "green"  ? "bg-emerald-100 text-emerald-700" :
                  color == "yellow" ? "bg-amber-100 text-amber-700" :
                                      "bg-red-100 text-red-700" %>">
              <%= listing.score %>
            </span>
          <% end %>
        </div>

        <%# Rent + key stats %>
        <div class="flex items-center gap-3 mb-3">
          <% if listing.rent %>
            <span class="text-xl font-bold text-gray-900">$<%= number_with_delimiter(listing.rent) %></span>
            <%# Budget badge %>
            <% case listing.budget_label
               when "under_2k" %>
              <span class="text-xs bg-emerald-100 text-emerald-700 rounded-full px-2 py-0.5 font-medium">✓ Under $2k</span>
            <% when "soft_limit" %>
              <span class="text-xs bg-amber-100 text-amber-700 rounded-full px-2 py-0.5 font-medium">~ Soft Limit</span>
            <% when "over_budget" %>
              <span class="text-xs bg-red-100 text-red-700 rounded-full px-2 py-0.5 font-medium">✗ Over Budget</span>
            <% end %>
          <% else %>
            <span class="text-gray-400 text-sm">Rent unknown</span>
          <% end %>
        </div>

        <%# Icon row %>
        <div class="flex items-center gap-3 text-sm text-gray-600 mb-3">
          <span><%= listing.parking ? "🚗 Parking" : "🚫 No parking" %></span>
          <% if listing.bedrooms %>
            <span>🛏 <%= listing.bedrooms %> BR</span>
          <% end %>
          <% if listing.sqft %>
            <span>📐 <%= number_with_delimiter(listing.sqft) %> sqft</span>
          <% end %>
        </div>

        <%# Top 2 pros %>
        <% if listing.top_pros.any? %>
          <div class="flex flex-wrap gap-1.5">
            <% listing.top_pros.each do |pro| %>
              <span class="text-xs bg-indigo-50 text-indigo-700 rounded-full px-2.5 py-0.5 border border-indigo-100">
                <%= pro %>
              </span>
            <% end %>
          </div>
        <% end %>
      </div>
    <% end %>
  <% end %>
</div>

<%# ── Floating Action Button ── %>
<%= link_to new_listing_path,
      class: "fixed bottom-6 right-6 z-50 w-14 h-14 rounded-full bg-indigo-600 hover:bg-indigo-700
              active:bg-indigo-800 text-white text-3xl flex items-center justify-center shadow-xl
              transition-all active:scale-95" do %>
  +
<% end %>
