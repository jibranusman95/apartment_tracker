<% content_for :title, "Edit Listing" %>

<header class="sticky top-0 z-40 bg-white border-b border-gray-200 shadow-sm">
  <div class="px-4 sm:px-6 py-3 flex items-center gap-3">
    <%= link_to listing_path(@listing, back: params[:back]), class: "text-indigo-600 font-medium text-sm hover:text-indigo-800" do %>
      ← Back
    <% end %>
    <h1 class="text-lg font-bold text-gray-900">Edit Listing</h1>
  </div>
</header>

<div class="px-4 sm:px-6 py-6 max-w-2xl mx-auto">
  <%= form_with model: @listing, class: "space-y-5" do |f| %>

    <%# Source & URL %>
    <div class="bg-white rounded-2xl border border-gray-200 p-4 space-y-3">
      <h2 class="font-semibold text-gray-900">Source</h2>

      <div>
        <%= f.label :source, "Website / Source", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.text_field :source,
              placeholder: "e.g. Kijiji, Facebook Marketplace…",
              class: "w-full rounded-xl border border-gray-300 px-3 py-3 text-sm focus:outline-none
                      focus:ring-2 focus:ring-indigo-500 bg-white" %>
      </div>

      <div>
        <%= f.label :url, "Listing URL", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.url_field :url,
              placeholder: "https://…",
              class: "w-full rounded-xl border border-gray-300 px-3 py-3 text-sm focus:outline-none
                      focus:ring-2 focus:ring-indigo-500 bg-white" %>
      </div>
    </div>

    <%# Core fields %>
    <div class="bg-white rounded-2xl border border-gray-200 p-4 space-y-3">
      <h2 class="font-semibold text-gray-900">Details</h2>

      <div class="grid grid-cols-2 gap-3">
        <div>
          <%= f.label :rent, "Rent ($/mo)", class: "block text-xs font-medium text-gray-600 mb-1" %>
          <%= f.number_field :rent, min: 0, class: "w-full rounded-xl border border-gray-300 px-3 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 bg-white" %>
        </div>
        <div>
          <%= f.label :bedrooms, "Bedrooms", class: "block text-xs font-medium text-gray-600 mb-1" %>
          <%= f.number_field :bedrooms, min: 0, step: 0.1, class: "w-full rounded-xl border border-gray-300 px-3 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 bg-white" %>
          <p class="text-xs text-gray-400 mt-1">1.5–1.7 = 1BR+Den, 2.5–2.7 = 2BR+Den</p>
        </div>
        <div>
          <%= f.label :bathrooms, "Bathrooms", class: "block text-xs font-medium text-gray-600 mb-1" %>
          <%= f.number_field :bathrooms, min: 0, step: 0.5, class: "w-full rounded-xl border border-gray-300 px-3 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 bg-white" %>
        </div>
        <div>
          <%= f.label :sqft, "Sq. Ft.", class: "block text-xs font-medium text-gray-600 mb-1" %>
          <%= f.number_field :sqft, min: 0, class: "w-full rounded-xl border border-gray-300 px-3 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 bg-white" %>
        </div>
        <div>
          <%= f.label :neighbourhood, "Neighbourhood", class: "block text-xs font-medium text-gray-600 mb-1" %>
          <%= f.text_field :neighbourhood, class: "w-full rounded-xl border border-gray-300 px-3 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 bg-white" %>
        </div>
        <div>
          <%= f.label :city, "City", class: "block text-xs font-medium text-gray-600 mb-1" %>
          <%= f.text_field :city, class: "w-full rounded-xl border border-gray-300 px-3 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 bg-white" %>
        </div>
        <div>
          <%= f.label :available_date, "Available Date", class: "block text-xs font-medium text-gray-600 mb-1" %>
          <%= f.text_field :available_date, class: "w-full rounded-xl border border-gray-300 px-3 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 bg-white" %>
        </div>
        <div>
          <%= f.label :parking_details, "Parking Details", class: "block text-xs font-medium text-gray-600 mb-1" %>
          <%= f.text_field :parking_details, class: "w-full rounded-xl border border-gray-300 px-3 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 bg-white" %>
        </div>
      </div>

      <div class="grid grid-cols-2 gap-3 pt-1">
        <div>
          <%= f.label :laundry, "Laundry", class: "block text-xs font-medium text-gray-600 mb-1" %>
          <%= f.select :laundry, [["— unknown —", nil], ["In-unit", "in-unit"], ["Shared", "shared"], ["None", "none"]],
                {},
                class: "w-full rounded-xl border border-gray-300 px-3 py-2.5 text-sm focus:outline-none
                        focus:ring-2 focus:ring-indigo-500 bg-white" %>
        </div>
        <div>
          <%= f.label :status, "Status", class: "block text-xs font-medium text-gray-600 mb-1" %>
          <%= f.select :status, [["Active", "active"], ["Gone", "gone"]],
                {},
                class: "w-full rounded-xl border border-gray-300 px-3 py-2.5 text-sm focus:outline-none
                        focus:ring-2 focus:ring-indigo-500 bg-white" %>
        </div>
      </div>

      <div class="flex flex-wrap gap-4 pt-1 text-sm">
        <label class="flex items-center gap-2 cursor-pointer">
          <%= f.check_box :parking, class: "rounded text-indigo-600 focus:ring-indigo-500" %>
          <span class="text-gray-700">Parking</span>
        </label>
        <label class="flex items-center gap-2 cursor-pointer">
          <%= f.check_box :balcony, class: "rounded text-indigo-600 focus:ring-indigo-500" %>
          <span class="text-gray-700">Balcony</span>
        </label>
        <label class="flex items-center gap-2 cursor-pointer">
          <%= f.check_box :pets_allowed, class: "rounded text-indigo-600 focus:ring-indigo-500" %>
          <span class="text-gray-700">Pets allowed</span>
        </label>
      </div>
    </div>

    <%# AI Summary %>
    <div class="bg-white rounded-2xl border border-gray-200 p-4 space-y-2">
      <h2 class="font-semibold text-gray-900">AI Summary</h2>
      <%= f.text_area :ai_summary, rows: 3,
            class: "w-full rounded-xl border border-gray-300 px-3 py-3 text-sm focus:outline-none
                    focus:ring-2 focus:ring-indigo-500 bg-white resize-none" %>
    </div>

    <%= f.submit "Save Changes",
          class: "w-full bg-indigo-600 hover:bg-indigo-700 text-white font-semibold
                  rounded-2xl py-4 text-base transition-colors shadow-sm cursor-pointer" %>
  <% end %>
</div>
