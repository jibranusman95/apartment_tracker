<% content_for :title, "Edit Listing" %>

<header class="sticky top-0 z-40 bg-white border-b border-gray-200 shadow-sm">
  <div class="max-w-2xl mx-auto px-4 py-3 flex items-center gap-3">
    <%= link_to listing_path(@listing), class: "text-indigo-600 font-medium text-sm hover:text-indigo-800" do %>
      ← Back
    <% end %>
    <h1 class="text-lg font-bold text-gray-900">Edit Listing</h1>
  </div>
</header>

<div class="px-4 py-6">
  <%= form_with model: @listing, class: "space-y-5" do |f| %>

    <%# Source & URL %>
    <div class="bg-white rounded-2xl border border-gray-200 p-4 space-y-3">
      <h2 class="font-semibold text-gray-900">Source</h2>

      <div>
        <%= f.label :source, "Website / Source", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.text_field :source,
              placeholder: "e.g. Kijiji, Facebook Marketplace…",
              class: "w-full rounded-xl border border-gray-300 px-3 py-3 text-sm focus:outline-none
                      focus:ring-2 focus:ring-indigo-500 bg-white" %>
      </div>

      <div>
        <%= f.label :url, "Listing URL", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.url_field :url,
              placeholder: "https://…",
              class: "w-full rounded-xl border border-gray-300 px-3 py-3 text-sm focus:outline-none
                      focus:ring-2 focus:ring-indigo-500 bg-white" %>
      </div>
    </div>

    <%# Core fields %>
    <div class="bg-white rounded-2xl border border-gray-200 p-4 space-y-3">
      <h2 class="font-semibold text-gray-900">Details</h2>

      <div class="grid grid-cols-2 gap-3">
        <% field = ->(form, attr, label, type: :text_field, **opts) do %>
          <div>
            <%= form.label attr, label, class: "block text-xs font-medium text-gray-600 mb-1" %>
            <%= form.send(type, attr,
                  class: "w-full rounded-xl border border-gray-300 px-3 py-2.5 text-sm focus:outline-none
                          focus:ring-2 focus:ring-indigo-500 bg-white", **opts) %>
          </div>
        <% end %>

        <%= field.call(f, :rent,          "Rent ($/mo)",  type: :number_field, min: 0) %>
        <%= field.call(f, :bedrooms,      "Bedrooms",     type: :number_field, min: 0) %>
        <%= field.call(f, :bathrooms,     "Bathrooms",    type: :number_field, min: 0, step: 0.5) %>
        <%= field.call(f, :sqft,          "Sq. Ft.",      type: :number_field, min: 0) %>
        <%= field.call(f, :neighbourhood, "Neighbourhood") %>
        <%= field.call(f, :city,          "City") %>
        <%= field.call(f, :available_date,"Available Date") %>
        <%= field.call(f, :parking_details, "Parking Details") %>
      </div>

      <div class="grid grid-cols-2 gap-3 pt-1">
        <div>
          <%= f.label :laundry, "Laundry", class: "block text-xs font-medium text-gray-600 mb-1" %>
          <%= f.select :laundry, [["— unknown —", nil], ["In-unit", "in-unit"], ["Shared", "shared"], ["None", "none"]],
                {},
                class: "w-full rounded-xl border border-gray-300 px-3 py-2.5 text-sm focus:outline-none
                        focus:ring-2 focus:ring-indigo-500 bg-white" %>
        </div>
        <div>
          <%= f.label :status, "Status", class: "block text-xs font-medium text-gray-600 mb-1" %>
          <%= f.select :status, [["Active", "active"], ["Gone", "gone"]],
                {},
                class: "w-full rounded-xl border border-gray-300 px-3 py-2.5 text-sm focus:outline-none
                        focus:ring-2 focus:ring-indigo-500 bg-white" %>
        </div>
      </div>

      <div class="flex flex-wrap gap-4 pt-1 text-sm">
        <label class="flex items-center gap-2 cursor-pointer">
          <%= f.check_box :parking, class: "rounded text-indigo-600 focus:ring-indigo-500" %>
          <span class="text-gray-700">Parking</span>
        </label>
        <label class="flex items-center gap-2 cursor-pointer">
          <%= f.check_box :balcony, class: "rounded text-indigo-600 focus:ring-indigo-500" %>
          <span class="text-gray-700">Balcony</span>
        </label>
        <label class="flex items-center gap-2 cursor-pointer">
          <%= f.check_box :pets_allowed, class: "rounded text-indigo-600 focus:ring-indigo-500" %>
          <span class="text-gray-700">Pets allowed</span>
        </label>
      </div>
    </div>

    <%# AI Summary %>
    <div class="bg-white rounded-2xl border border-gray-200 p-4 space-y-2">
      <h2 class="font-semibold text-gray-900">AI Summary</h2>
      <%= f.text_area :ai_summary, rows: 3,
            class: "w-full rounded-xl border border-gray-300 px-3 py-3 text-sm focus:outline-none
                    focus:ring-2 focus:ring-indigo-500 bg-white resize-none" %>
    </div>

    <%= f.submit "Save Changes",
          class: "w-full bg-indigo-600 hover:bg-indigo-700 text-white font-semibold
                  rounded-2xl py-4 text-base transition-colors shadow-sm cursor-pointer" %>
  <% end %>
</div>
