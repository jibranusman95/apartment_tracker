<% content_for :title, "Enter PIN" %>

<div class="min-h-screen flex flex-col items-center justify-center px-4 py-10 gap-8">

  <%# ── PIN form ── %>
  <div class="w-full max-w-xs">
    <div class="text-center mb-8">
      <div class="text-5xl mb-3">🏠</div>
      <h1 class="text-2xl font-bold text-gray-900">Home Finder</h1>
      <p class="text-gray-500 text-sm mt-1">Enter your PIN to continue</p>
    </div>

    <% if flash[:error] %>
      <div class="mb-4 rounded-xl bg-red-50 border border-red-200 px-4 py-3 text-sm text-red-700">
        <%= flash[:error] %>
      </div>
    <% end %>

    <%= form_with url: session_path, method: :post, class: "space-y-4" do |f| %>
      <div>
        <%= f.label :pin, "4-digit PIN", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.password_field :pin,
              maxlength: 4,
              inputmode: "numeric",
              pattern: "[0-9]{4}",
              autofocus: true,
              autocomplete: "off",
              placeholder: "••••",
              class: "w-full text-center text-3xl tracking-widest rounded-2xl border border-gray-300
                      px-4 py-4 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent
                      bg-white shadow-sm" %>
      </div>

      <%= f.submit "Unlock",
            class: "w-full bg-indigo-600 hover:bg-indigo-700 active:bg-indigo-800 text-white
                    font-semibold rounded-2xl py-4 text-base transition-colors shadow-sm cursor-pointer" %>
    <% end %>
  </div>

  <%# ── Supported sites tip ── %>
  <div class="w-full max-w-xs">
    <p class="text-xs font-semibold text-gray-400 uppercase tracking-wide text-center mb-3">How to add listings</p>
    <div class="bg-white rounded-2xl border border-gray-200 shadow-sm divide-y divide-gray-100 text-sm">

      <div class="px-4 py-3">
        <p class="font-medium text-gray-700 mb-2">✅ Paste the URL — works automatically</p>
        <div class="flex flex-wrap gap-1.5">
          <% %w[ Kijiji Rentals.ca PadMapper Zumper Liv.rent ViewIt GottaRent Craigslist ].each do |site| %>
            <span class="bg-emerald-50 text-emerald-700 border border-emerald-100 rounded-full px-2.5 py-0.5 text-xs"><%= site %></span>
          <% end %>
        </div>
      </div>

      <div class="px-4 py-3">
        <p class="font-medium text-gray-700 mb-2">⚠️ URL usually works — may need copy-paste</p>
        <div class="flex flex-wrap gap-1.5">
          <% [ "Realtor.ca", "Apartments.com", "Zillow", "HotPads" ].each do |site| %>
            <span class="bg-amber-50 text-amber-700 border border-amber-100 rounded-full px-2.5 py-0.5 text-xs"><%= site %></span>
          <% end %>
        </div>
      </div>

      <div class="px-4 py-3">
        <p class="font-medium text-gray-700 mb-2">❌ Copy-paste the description instead</p>
        <div class="flex flex-wrap gap-1.5">
          <span class="bg-red-50 text-red-600 border border-red-100 rounded-full px-2.5 py-0.5 text-xs">Facebook Marketplace</span>
        </div>
        <p class="text-xs text-gray-400 mt-2">Requires Facebook login — just copy the listing text and paste it in.</p>
      </div>

    </div>
  </div>

</div>
