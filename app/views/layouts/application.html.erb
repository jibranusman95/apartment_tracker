<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= content_for(:title) || "Home Finder" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="bg-gray-50 min-h-screen font-sans text-gray-900">

    <%# Flash messages — auto-dismiss via Stimulus later %>
    <div id="flash-messages" class="fixed top-0 inset-x-0 z-50 p-3 space-y-2 pointer-events-none">
      <% flash.each do |type, message| %>
        <% bg = type.to_s == "error" ? "bg-red-100 text-red-800 border-red-200" :
                type.to_s == "warning" ? "bg-amber-100 text-amber-800 border-amber-200" :
                "bg-emerald-100 text-emerald-800 border-emerald-200" %>
        <div class="pointer-events-auto mx-auto max-w-lg rounded-xl px-4 py-3 text-sm font-medium shadow-lg border <%= bg %>">
          <%= message %>
        </div>
      <% end %>
    </div>

    <div class="pb-28 max-w-2xl mx-auto">
      <%= yield %>
    </div>

  </body>
</html>
